{
  "expo": {
    "name": "Ziza Driver",
    "slug": "ziza-driver",
    "owner": "zizatransportationllc",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zizatransportation.driver",
      "infoPlist": {
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Ziza shares your location with customers during trips.",
        "NSLocationWhenInUseUsageDescription": "Ziza uses your location to calculate trips."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1D4ED8"
      },
      "package": "com.zizatransportation.driver",
      "permissions": [
        "ACCESS_BACKGROUND_LOCATION",
        "ACCESS_FINE_LOCATION",
        "FOREGROUND_SERVICE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Ziza shares your location with customers during trips."
        }
      ],
      "expo-task-manager"
    ],
    "extra": {
      "eas": {
        "projectId": "a9101d07-0dd7-4b2a-9888-a377194be7c1"
      }
    }
  }
}
