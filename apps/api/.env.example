# ZIZA API — environment template.
# Copy this file to `.env` (gitignored) and fill in real values for local dev.
# In deployed environments (dev/prod) these come from GCP Secret Manager, not .env.

# ------------------------------------------------------------------
# Payment / payout providers
# ------------------------------------------------------------------
# "mock" (default, no external calls) | "stripe" | "cinetpay" | "wellsfargo"
PAYMENT_PROVIDER=mock
# "mock" | "stripe" (Connect) | "wellsfargo" (Gateway ACH/RTP)
PAYOUT_PROVIDER=mock

# ------------------------------------------------------------------
# Stripe — split-at-charge (destination charges) + Issuing cards
# ------------------------------------------------------------------
STRIPE_SECRET_KEY=            # sk_test_... / sk_live_...  (backend, required for provider=stripe)
STRIPE_PUBLISHABLE_KEY=       # pk_test_... / pk_live_...  (client-side; unused by Checkout redirect)
STRIPE_WEBHOOK_SECRET=        # whsec_...  (required to verify /v1/payments/webhook)

# ------------------------------------------------------------------
# Payment-split tuning (optional — defaults live in app/config.py;
# admins can also change these at runtime via /v1/admin/settings/payments)
# ------------------------------------------------------------------
# RIDE_TAX_FLAT_CENTS=50
# RIDE_DRIVER_SPLIT_PCT=50
# CRAFT_PLATFORM_FEE_PCT=10.0
# CRAFT_TAX_PCT=6.625
# STRIPE_FEE_PCT=2.9
# STRIPE_FEE_FIXED_CENTS=30

# ------------------------------------------------------------------
# Withdrawals kill-switch (keep False in prod — funds go to the Issuing card)
# ------------------------------------------------------------------
# INTERNAL_WITHDRAWALS_ENABLED=false
