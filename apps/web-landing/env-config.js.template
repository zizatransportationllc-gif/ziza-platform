/* env-config.js — auto-generated at container startup from env-config.js.template
   DO NOT edit this file directly; edit the .template source instead.
   Variables are injected at runtime via envsubst so the same Docker image
   works in every environment (local, staging, production). */
window.ZIZA_DRIVER_URL   = "${ZIZA_DRIVER_URL}";
window.ZIZA_CUSTOMER_URL = "${ZIZA_CUSTOMER_URL}";
window.ZIZA_CRAFT_URL    = "${ZIZA_CRAFT_URL}";
window.ZIZA_API_URL      = "${ZIZA_API_URL}";
/* Firebase web config (public by design). When set, the admin editor signs in
   via Firebase (Google popup or email+password) — required in prod where the
   DEV POST /v1/token endpoint is disabled (404). Empty -> DEV /v1/token flow. */
window.ZIZA_FIREBASE_API_KEY     = "${ZIZA_FIREBASE_API_KEY}";
window.ZIZA_FIREBASE_AUTH_DOMAIN = "${ZIZA_FIREBASE_AUTH_DOMAIN}";
window.ZIZA_FIREBASE_PROJECT_ID  = "${ZIZA_FIREBASE_PROJECT_ID}";
