{
  "expo": {
    "name": "Ziza Customer",
    "slug": "ziza-customer",
    "owner": "zizatransportationllc",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "splash": {
      "backgroundColor": "#F97316"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zizatransportation.customer",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Ziza uses your location to find drivers near you and calculate fares."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F97316"
      },
      "package": "com.zizatransportation.customer",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Ziza uses your location to find drivers near you and calculate fares."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "cd385854-11bf-43d9-a476-c0af59bd8afb"
      }
    }
  }
}
