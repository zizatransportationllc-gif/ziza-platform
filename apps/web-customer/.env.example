# web-customer build-time env (Vite). Copy to .env for local dev.

# Backend API base URL
VITE_API_URL=http://localhost:8000

# Firebase auth (project: ziza-platform). The web API key is PUBLIC by design
# (it identifies the project, it is not a secret). When set, the app uses
# Firebase identity + POST /v1/auth/firebase; when empty, it falls back to the
# DEV /v1/token flow.
VITE_FIREBASE_API_KEY=AIzaSyCv2PZ03w-zBqQ4p2D2b6oVwBga06WG69c
VITE_FIREBASE_AUTH_DOMAIN=ziza-platform.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ziza-platform

# Map rendering
VITE_MAPBOX_TOKEN=
