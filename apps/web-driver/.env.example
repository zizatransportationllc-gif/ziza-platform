# web-driver build-time env (Vite). Copy to .env for local dev.
VITE_API_URL=http://localhost:8000

# Firebase auth (project: ziza-platform). Web API key is PUBLIC by design.
# When set, the app uses Firebase identity + POST /v1/auth/firebase (role: driver);
# when empty, it falls back to the DEV /v1/token flow.
VITE_FIREBASE_API_KEY=AIzaSyCv2PZ03w-zBqQ4p2D2b6oVwBga06WG69c
VITE_FIREBASE_AUTH_DOMAIN=ziza-platform.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ziza-platform

VITE_MAPBOX_TOKEN=
