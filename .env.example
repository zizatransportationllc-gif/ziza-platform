# =========================================================================
# Ziza Platform — local environment template
# Copy to .env and fill in. NEVER commit .env.
# =========================================================================

# Backend
ENVIRONMENT=dev
PORT=8000

# CORS — list all frontend origins (ports 3000-3003)
CORS_ORIGINS_RAW=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# Database (required for full functionality; omit to run in no-DB mode)
# Local PostgreSQL:
DATABASE_URL=postgresql+asyncpg://ziza:ziza-local@localhost:5432/ziza
# Via Docker Compose unix socket (Cloud SQL style):
# DATABASE_URL=postgresql+asyncpg://ziza:ziza-local@/ziza?host=/tmp

# Auth DEV (Sprint 2) — change AUTH_DEV_SECRET before sharing this env
AUTH_DEV_SECRET=dev-secret-change-me
AUTH_DEV_PASSWORD=ziza2024

# Auth PROD / Firebase (Sprint 3) — only needed in production
FIREBASE_PROJECT_ID=

# Frontends (build-time via Vite)
VITE_API_URL=http://localhost:8000
# Address autocomplete (all 4 web apps) — get a token at mapbox.com; without it
# address search silently returns no results (GPS-only fallback still works).
VITE_MAPBOX_TOKEN=
# Card entry on web-customer's "Payment methods" screen (Stripe Elements) — a
# pk_test_... publishable key (safe to share, not a secret) from the Stripe
# dashboard. Without it, "Add a card" shows "Card entry is unavailable right now."
VITE_STRIPE_PUBLISHABLE_KEY=

# GCP (only needed locally if you run scripts/deploy/* manually)
GCP_PROJECT_ID=
GCP_REGION=us-central1
AR_REPO=ziza
