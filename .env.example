# =========================================================================
# Ziza Platform — local environment template
# Copy to .env and fill in. NEVER commit .env.
# =========================================================================

# Backend
ENVIRONMENT=dev
CORS_ORIGINS_RAW=http://localhost:3001,http://localhost:3002,http://localhost:3003
PORT=8000

# Frontends (build-time)
VITE_API_URL=http://localhost:8000

# GCP (only needed locally if you run scripts/deploy/* manually)
GCP_PROJECT_ID=
GCP_REGION=us-central1
AR_REPO=ziza
